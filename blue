# MAIN
# ============================================================

def main():
    # Hide console
    try:
        ctypes.windll.user32.ShowWindow(ctypes.windll.kernel32.GetConsoleWindow(), 0)
    except:
        pass
    
    print("="*60)
    print("🖥️  BSOD SIMULATOR — Just a prank!")
    print("="*60)
    print("📌 This does NOT actually crash your PC")
    print("📌 Press Ctrl+Shift+Esc to exit")
    print("📌 Or just restart your computer")
    print("="*60)
    
    # Choose version:
    # app = BSODPrank()           # Simple BSOD
    app = BSODWithBootLoop()       # BSOD → Boot → BSOD loop
    app.setup()

if __name__ == '__main__':
    main()
