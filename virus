            hours = self.timer_seconds // 3600
            minutes = (self.timer_seconds % 3600) // 60
            secs = self.timer_seconds % 60
            self.timer_label.config(text=f"⏱️ {hours:02d}:{minutes:02d}:{secs:02d}")
            self.timer_seconds -= 1
            self.root.after(1000, update)
        update()
    
    def play_audio(self):
